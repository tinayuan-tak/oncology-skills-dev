      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "n_paired_samples": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "n_expr_samples": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "median_purity": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
