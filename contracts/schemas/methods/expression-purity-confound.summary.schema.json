      "type": [
        "null",
        "string"
      ]
    },
    "purity_source": {
      "type": [
        "null",
        "string"
      ]
    },
    "target": {
      "type": [
        "null",
        "string"
      ]
    },
    "indication": {
      "type": [
        "null",
        "string"
      ]
    },
    "method_version": {
      "type": [
        "null",
        "string"
      ]
    }
  }
