{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.onetakeda.oncology/target-contracts/methods/hpa-pathology-cancer-ihc.summary.schema.json",
  "title": "summary output schema for card hpa-pathology-cancer-ihc",
  "description": "Per-card summary-dict contract for 'hpa-pathology-cancer-ihc', generated by gen_summary_schemas.py from outputs.summary_fields (+ vocabulary/record schemas) and observed stub fixtures. additionalProperties:true by design (real summaries carry internal _-keys + computed extras); required is limited to the primary class field. Tighten per-card as coverage matures. compose-dashboard validates a summary against this schema ONLY if it exists (opt-in rollout).",
  "type": "object",
  "additionalProperties": true,
  "required": [],
  "properties": {
    "protein_presence_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ihc_detected_high",
        "ihc_detected_moderate",
        "ihc_detected_low",
        "ihc_not_detected",
        "data_unavailable",
        null
      ]
    },
    "fraction_detected": {
      "type": [
        "null",
        "number"
      ]
    },
    "fraction_moderate_strong": {
      "type": [
        "null",
        "number"
      ]
    },
    "staining_score": {
      "type": [
        "null",
        "number"
      ]
    },
    "n_high": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "n_medium": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "n_low": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "n_not_detected": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "n_patients_total": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "hpa_cancer_type": {
      "type": [
        "null",
        "string"
      ]
    },
    "prognostic_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "favorable",
        "unfavorable",
        "none",
        null
      ]
    },
    "prognostic_is_significant": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "prognostic_p_value": {
      "type": [
        "null",
        "number"
      ]
    },
    "method_version": {
      "type": [
        "null",
        "string"
      ]
    }
  }
}
