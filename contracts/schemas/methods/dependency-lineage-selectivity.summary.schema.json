{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.onetakeda.oncology/target-contracts/methods/dependency-lineage-selectivity.summary.schema.json",
  "title": "summary output schema for card dependency-lineage-selectivity",
  "description": "Per-card summary-dict contract for 'dependency-lineage-selectivity', generated by gen_summary_schemas.py from outputs.summary_fields (+ vocabulary/record schemas) and observed stub fixtures. additionalProperties:true by design (real summaries carry internal _-keys + computed extras); required is limited to the primary class field. Tighten per-card as coverage matures. compose-dashboard validates a summary against this schema ONLY if it exists (opt-in rollout).",
  "type": "object",
  "additionalProperties": true,
  "required": [],
  "properties": {
    "n_cell_lines_panel": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "median_chronos_panel": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "per_lineage_stats": {
      "type": [
        "array",
        "null"
      ]
    },
    "n_lineages_evaluated": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "per_oncotree_code_stats": {
      "type": [
        "array",
        "null"
      ]
    },
    "n_oncotree_codes_evaluated": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "enriched_lineages": {
      "type": [
        "array",
        "null"
      ]
    },
    "n_enriched_lineages": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "relative_only_enriched_lineages": {
