      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "enrichment_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "lineage_selective",
        "broadly_lineage_dependent",
        "no_lineage_enrichment",
        "data_unavailable",
