{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.onetakeda.oncology/target-contracts/methods/signaling-network-mechanism.summary.schema.json",
  "title": "summary output schema for card signaling-network-mechanism",
  "description": "Per-card summary-dict contract for 'signaling-network-mechanism', generated by gen_summary_schemas.py from outputs.summary_fields (+ vocabulary/record schemas) and observed stub fixtures. additionalProperties:true by design (real summaries carry internal _-keys + computed extras); required is limited to the primary class field. Tighten per-card as coverage matures. compose-dashboard validates a summary against this schema ONLY if it exists (opt-in rollout).",
  "type": "object",
  "additionalProperties": true,
  "required": [],
  "properties": {
    "network_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "well_characterized",
        "partial",
        "sparse",
        "data_unavailable",
        null
      ]
    },
    "n_upstream_regulators": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "n_downstream_effectors": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "upstream_regulators": {
      "type": [
        "array",
        "null"
      ]
    },
    "downstream_effectors": {
      "type": [
        "array",
        "null"
      ]
    },
    "moa_classes_present": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "upstream_gap_modulation",
        "upstream_gef_modulation",
        "upstream_kinase_modulation",
        "upstream_ppase_modulation",
        "upstream_ubl_modulation",
        "upstream_dub_modulation",
        "upstream_methyltransferase_modulation",
        "upstream_hat_modulation",
        "upstream_hdac_modulation",
        "upstream_protease_modulation",
        "upstream_transcriptional_modulation",
        "upstream_stimulator",
        "upstream_inhibitor",
        "upstream_transcriptional_activator",
        "upstream_transcriptional_repressor",
        "molecular_glue_disruptor",
        "unmapped",
        null
      ]
    },
    "pd_marker_classes_present": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "downstream_pd_marker",
        "downstream_pd_kinase",
        "downstream_pd_dephospho",
        "downstream_pd_ubiquitin",
        "downstream_pd_gap",
        "downstream_pd_gef",
        "transcriptional_pd_marker",
        "downstream_pd_cleavage",
        "downstream_pd_methylation",
        "downstream_activation_readout",
        "downstream_repression_readout",
        "downstream_transcriptional_activation_readout",
        "downstream_transcriptional_repression_readout",
        "unmapped",
        null
      ]
    },
    "has_actionable_moa": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "has_pd_marker": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "true",
        "false",
        null
      ]
    },
    "moa_ontology_version": {
      "type": [
        "null",
        "string"
      ]
    },
    "moa_ontology_unmapped_fraction": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "high_confidence_edges_count": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "source_counts": {
      "type": [
        "null",
        "object"
      ]
    },
    "sources_wired": {
      "type": [
        "array",
        "null"
      ]
    },
    "kinome_atlas_predictions": {
      "type": [
        "null",
        "object"
      ]
    },
    "coessentiality_context": {
      "type": [
        "null",
        "object"
      ]
    },
    "reactome_pathway_context": {
      "type": [
        "null",
        "object"
      ]
    }
  }
}
