{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.onetakeda.oncology/target-contracts/methods/normal-tissue-liability.summary.schema.json",
  "title": "summary output schema for card normal-tissue-liability",
  "description": "Per-card summary-dict contract for 'normal-tissue-liability', generated by gen_summary_schemas.py from outputs.summary_fields (+ vocabulary/record schemas) and observed stub fixtures. additionalProperties:true by design (real summaries carry internal _-keys + computed extras); required is limited to the primary class field. Tighten per-card as coverage matures. compose-dashboard validates a summary against this schema ONLY if it exists (opt-in rollout).",
  "type": "object",
  "additionalProperties": true,
  "required": [],
  "properties": {
    "normal_tissue_breadth_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "broad_normal_expression",
        "moderate_normal_expression",
        "restricted_normal_expression",
        "not_detected_in_normal",
        "data_unavailable",
        null
      ]
    },
    "essential_tissue_flag": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "present",
        "unknown",
        "absent",
        null
      ]
    },
    "hpa_tissue_distribution": {
      "type": [
        "null",
        "string"
      ]
    },
    "hpa_tissue_specificity": {
      "type": [
        "null",
        "string"
      ]
    },
    "n_essential_tissues_with_expression": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "essential_tissues_flagged": {
      "type": [
        "array",
        "null"
      ]
    },
    "n_specific_tissues": {
      "type": [
        "integer",
        "null",
        "number"
      ]
    },
    "specific_tissues": {
      "type": [
        "array",
        "null"
      ]
    },
    "safety_tissue_flags": {
      "type": [
        "array",
        "null"
      ]
    },
    "method_version": {
      "type": [
        "null",
        "string"
      ]
    }
  }
}
