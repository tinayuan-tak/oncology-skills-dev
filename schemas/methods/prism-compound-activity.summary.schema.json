{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.onetakeda.oncology/target-contracts/methods/prism-compound-activity.summary.schema.json",
  "title": "summary output schema for card prism-compound-activity",
  "description": "Per-card summary-dict contract for 'prism-compound-activity', generated by gen_summary_schemas.py from outputs.summary_fields (+ vocabulary/record schemas) and observed stub fixtures. additionalProperties:true by design (real summaries carry internal _-keys + computed extras); required is limited to the primary class field. Tighten per-card as coverage matures. compose-dashboard validates a summary against this schema ONLY if it exists (opt-in rollout).",
  "type": "object",
  "additionalProperties": true,
  "required": [],
  "properties": {
    "prism_activity_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "clinically_active",
        "clinical_precedent_only",
        "tool_compound_only",
        "weakly_active",
        "no_compounds_found",
        "data_unavailable",
        null
      ]
    },
    "n_compounds_targeting": {
      "type": [
        "null"
      ]
    },
    "highest_clinical_phase": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "approved",
        "phase_1_plus",
        "preclinical",
        "tool",
        null
      ]
    },
    "median_log2auc_across_compounds": {
      "type": [
        "null"
      ]
    },
    "top_compounds": {
      "type": [
        "null"
      ]
    },
    "per_lineage_activity": {
      "type": [
        "null"
      ]
    },
    "prism_lineage_selectivity": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "lineage_selective",
        "broadly_active",
        "no_lineage_signal",
        "data_unavailable",
        null
      ]
    }
  }
}
