{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.onetakeda.oncology/target-contracts/methods/clingen-dosage.summary.schema.json",
  "title": "summary output schema for card clingen-dosage",
  "description": "Per-card summary-dict contract for 'clingen-dosage', generated by gen_summary_schemas.py from outputs.summary_fields (+ vocabulary/record schemas) and observed stub fixtures. additionalProperties:true by design (real summaries carry internal _-keys + computed extras); required is limited to the primary class field. Tighten per-card as coverage matures. compose-dashboard validates a summary against this schema ONLY if it exists (opt-in rollout).",
  "type": "object",
  "additionalProperties": true,
  "required": [],
  "properties": {
    "dosage_sensitivity_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "autosomal_dominant_loss",
        "dosage_sufficient",
        "unresolved",
        "no_clingen_entry",
        "insufficient",
        null
      ]
    },
    "n_high_confidence": {
      "type": [
        "null"
      ]
    },
    "n_total_rows": {
      "type": [
        "null"
      ]
    },
    "n_autosomal_dominant": {
      "type": [
        "null"
      ]
    },
    "n_autosomal_recessive": {
      "type": [
        "null"
      ]
    },
    "allelic_requirements": {
      "type": [
        "null"
      ]
    },
    "top_disease": {
      "type": [
        "null"
      ]
    },
    "top_confidence": {
      "type": [
        "null"
      ]
    },
    "germline_inheritance_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "recessive_only",
        "dominant",
        "dominant_and_recessive",
        "xlinked_or_other",
        "no_mendelian_disease",
        "insufficient",
        null
      ]
    },
    "inheritance_allelic_requirements": {
      "type": [
        "null"
      ]
    },
    "method_version": {
      "type": [
        "null"
      ]
    }
  }
}
