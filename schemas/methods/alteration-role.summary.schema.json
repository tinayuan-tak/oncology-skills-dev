{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.onetakeda.oncology/target-contracts/methods/alteration-role.summary.schema.json",
  "title": "summary output schema for card alteration-role",
  "description": "Per-card summary-dict contract for 'alteration-role', generated by gen_summary_schemas.py from outputs.summary_fields (+ vocabulary/record schemas) and observed stub fixtures. additionalProperties:true by design (real summaries carry internal _-keys + computed extras); required is limited to the primary class field. Tighten per-card as coverage matures. compose-dashboard validates a summary against this schema ONLY if it exists (opt-in rollout).",
  "type": "object",
  "additionalProperties": true,
  "required": [],
  "properties": {
    "alteration_role": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "direct_driver_gof",
        "direct_driver_lof",
        "predictive_biomarker",
        "passenger",
        "data_unavailable",
        null
      ]
    },
    "functional_direction": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "activating",
        "loss_of_function",
        "ambiguous",
        null
      ]
    },
    "oncokb_gene_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ONCOGENE",
        "TSG",
        "ONCOGENE_AND_TSG",
        "NEITHER",
        "INSUFFICIENT",
        null
      ]
    },
    "intogen_role": {
      "type": [
        "null"
      ]
    },
    "intogen_scope": {
      "type": [
        "null"
      ]
    },
    "intogen_min_qvalue": {
      "type": [
        "null"
      ]
    },
    "intogen_max_pct_samples": {
      "type": [
        "null"
      ]
    },
    "intogen_cancer_types": {
      "type": [
        "null"
      ]
    },
    "sources": {
      "type": [
        "null"
      ]
    }
  }
}
