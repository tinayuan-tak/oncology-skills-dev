{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/takeda-rnd/rnd-computational-biology-oncology-target-contracts/schemas/evidence_graph.schema.json",
  "title": "Evidence Graph",
  "$comment": "PROV / ECO / SEPIO crosswalk (advisory; NO ontology is imported and NO RDF is emitted — the bespoke JSON stays canonical). The `chain` edges map onto W3C PROV: a dataset node is a prov:Entity; a card's evidence is a prov:Activity that prov:used the dataset(s) and whose class value prov:wasGeneratedBy the method; a rule is a prov:Activity that prov:used the evidence, and the verdict prov:wasDerivedFrom the driving rule (verdict.driving_rule_id). ECO: the optional card.confidence.eco_id annotates evidence_state with an Evidence & Conclusion Ontology code (measured/comparator -> ECO:0000006 experimental evidence; inferred -> ECO:0000363 imported information used in automatic assertion; data_unavailable -> null). SEPIO framing: each verdict-bearing card is an evidence line (the card node) whose evidence items are its datasets + key_evidence and whose assertion is the fired rule; literature.axes are corroborating/contrasting evidence lines (agreement_vs_omics). These IDs are optional/nullable interoperability hooks only.",
  "description": "Schema for the additive, DISPLAY-ONLY claim graph emitted at decision.headline.evidence_graph by a subskill data package. It is a one-way relational projection over data already present in decision.json (verdict spine + cards + fired_rules + subgroup_signals/evidence_capsules + question_table + optional literature_synthesis/llm_synthesis) so downstream renderers read explicit, stably-keyed edges (question <-> card <-> rule <-> dataset <-> literature-axis <-> citation <-> narrative) instead of re-deriving joins. It introduces NO new science and feeds NO rule/resolver/gate. Datasets and citations are deduplicated into id-keyed arrays; every other node references them by id. Referential integrity is an invariant: every id referenced by an edge must resolve to a node in the same package. Fields are widely nullable because the graph is an honest projection: an unmeasured/unbound signal, an axis with no literature, or a question with no cards is emitted with null/empty edges, never dropped.",
  "type": "object",
  "required": ["schema_version", "skill", "verdict", "questions", "cards", "rules", "datasets", "literature", "citations", "narrative"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "skill": {"type": ["string", "null"]},
    "target": {"type": ["string", "null"]},
    "indication": {"type": ["string", "null"]},
    "verdict": {"$ref": "#/$defs/verdict"},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
    "cards": {"type": "array", "items": {"$ref": "#/$defs/card"}},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "datasets": {"type": "array", "items": {"$ref": "#/$defs/dataset"}},
    "literature": {"$ref": "#/$defs/literature"},
    "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
    "narrative": {"$ref": "#/$defs/narrative"}
  },
  "$defs": {
    "id_ref": {"type": "string", "minLength": 1},
    "id_ref_array": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}},
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier": {"type": ["string", "null"]},
        "polarity": {"type": ["string", "null"], "description": "Canonical display polarity (ordinal_view vocabulary): supportive | neutral | opposing | killer | not_applicable. Nullable when unbound. Not a verdict input."},
        "label": {"type": ["string", "null"]},
        "liability": {"type": "boolean", "description": "True when this card carries a safety/normal-tissue liability class (polarity is then killer). Orthogonal flag so a renderer can label a liability distinctly from a generic killer without re-deriving it from the class string. Absent on question signals."}
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": ["string", "null"]},
        "call": {"type": ["string", "null"]},
        "polarity": {"type": ["string", "null"]},
        "driving_rule_id": {"type": ["string", "null"]},
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {"type": ["string", "null"]},
            "coverage": {"type": ["object", "null"]}
          }
        },
        "top_tension": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "text": {"type": ["string", "null"]},
            "severity": {"type": ["integer", "number", "null"]},
            "source_card_ids": {"$ref": "#/$defs/id_ref_array"}
          }
        }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "card_ids", "rule_ids", "literature_axis_ids"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id_ref"},
        "seq": {"type": ["integer", "null"]},
        "text": {"type": ["string", "null"]},
        "axis_id": {"type": ["string", "null"]},
        "role": {"type": ["string", "null"], "enum": ["verdict_bearing", "corroboration", "display_only", "context", "descriptive", null]},
        "signal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tier": {"type": ["string", "null"]},
            "polarity": {"type": ["string", "null"]},
            "label": {"type": ["string", "null"]}
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {"type": ["string", "null"]},
            "dots": {"type": ["integer", "null"]},
            "label": {"type": ["string", "null"]}
          }
        },
        "card_ids": {"$ref": "#/$defs/id_ref_array"},
        "rule_ids": {"$ref": "#/$defs/id_ref_array"},
        "literature_axis_ids": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "card_id": {"$ref": "#/$defs/id_ref"},
              "field": {"type": ["string", "null"]},
              "value": {},
              "label": {"type": ["string", "null"]}
            }
          }
        },
        "prose": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": {"type": ["string", "null"]},
            "support": {"type": ["string", "null"]}
          }
        }
      }
    },
    "card": {
      "type": "object",
      "required": ["id", "role", "question_ids", "dataset_ids", "rule_ids", "chain"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id_ref"},
        "measurement_type": {"type": ["string", "null"]},
        "tier": {"type": ["string", "null"]},
        "role": {"type": "string", "enum": ["verdict_bearing", "display_only"]},
        "question_ids": {"$ref": "#/$defs/id_ref_array"},
        "axis_id": {"type": ["string", "null"]},
        "signal": {"$ref": "#/$defs/signal"},
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {"type": ["string", "null"]},
            "dots": {"type": ["integer", "null"]},
            "evidence_state": {"type": ["string", "null"]},
            "eco_id": {"type": ["string", "null"], "description": "OPTIONAL Evidence & Conclusion Ontology code annotating evidence_state (measured -> ECO:0000006 experimental evidence; comparator -> ECO:0000006; inferred -> ECO:0000363 imported/computational; else null). An advisory interoperability annotation only — no ontology is imported and no RDF is emitted (see the top-level $comment PROV/ECO/SEPIO crosswalk). Nullable; feeds no rule/gate."},
            "n": {"type": ["integer", "number", "null"]}
          }
        },
        "class": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "field": {"type": ["string", "null"]},
            "value": {}
          }
        },
        "dataset_ids": {"$ref": "#/$defs/id_ref_array"},
        "rule_ids": {"$ref": "#/$defs/id_ref_array"},
        "chain": {
          "type": "object",
          "required": ["rule_id", "contributes_to_verdict", "is_driving"],
          "additionalProperties": false,
          "properties": {
            "dataset_ids": {"$ref": "#/$defs/id_ref_array"},
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {"field": {"type": ["string", "null"]}, "value": {}}
              }
            },
            "rule_id": {"type": ["string", "null"]},
            "contributes_to_verdict": {"type": "boolean"},
            "is_driving": {"type": "boolean"}
          }
        },
        "key_fields": {"type": "object"},
        "key_evidence": {"$ref": "#/$defs/key_evidence"}
      }
    },
    "key_evidence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Bounded, typed promotion of the DECISIVE data points behind this card, projected from the evidence_capsule (top_k_strata / n_basis / categorical_anchors / sibling_caveats / conflict_pairs) plus per-measurement_type-pinned significance fields. ADDITIVE + DISPLAY-ONLY: the grounding substrate for the narrator + card-chain renderer. Full arrays remain only in decision.cards[].summary. All members optional/nullable (an honest projection: absent -> omitted). Feeds NO rule/resolver/gate.",
      "properties": {
        "effect": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "description": "The load-bearing effect for this card (e.g. the indication/strongest stratum's median_chronos, a log2FC, a correlation r, a LOEUF).",
          "properties": {
            "metric": {"type": ["string", "null"]},
            "value": {"type": ["number", "integer", "null"]},
            "direction": {"type": ["string", "null"], "description": "lower_is_stronger | higher_is_stronger | higher_is_worse | near_zero_is_independent | ... (display hint; not a verdict input)."}
          }
        },
        "n": {"type": ["integer", "number", "null"], "description": "Panel/cohort/model basis for the effect."},
        "significance": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "description": "The significance statistic behind the effect (q_value / p_value / mannwhitney_q / LOEUF / pLI). The most-dropped decisive field pre-key_evidence.",
          "properties": {
            "stat": {"type": ["string", "null"]},
            "value": {"type": ["number", "integer", "null"]}
          }
        },
        "omnibus": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "description": "A cross-stratum omnibus test (e.g. lineage_omnibus_p / subtype_omnibus_p). Explicitly pinned; does not rely on the anchor-hint heuristic.",
          "properties": {
            "stat": {"type": ["string", "null"]},
            "value": {"type": ["number", "integer", "null"]}
          }
        },
        "top_strata": {
          "type": "array",
          "description": "<=3 salient strata rows (indication + strongest + weakest), each carrying its effect value, n, and q where the row has it.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {"type": ["string", "null"]},
              "role": {"type": ["string", "null"], "enum": ["indication", "strongest", "weakest", "subtype", null]},
              "value": {"type": ["number", "integer", "null"]},
              "n": {"type": ["integer", "number", "null"]},
              "q": {"type": ["number", "integer", "null"]}
            }
          }
        },
        "categorical": {
          "type": "array",
          "description": "Decisive non-numeric labels the numeric selectors cannot carry (fit_class, highest_tissue, dep_control_position_class, ...).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {"type": ["string", "null"]},
              "value": {}
            }
          }
        },
        "n_basis": {"type": ["object", "null"], "description": "The decisive count(s) behind a categorical/liability verdict (n_pathogenic_germline, n_lethal, ...)."},
        "conflict": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "description": "Sibling-card tier disagreement on this measurement_type (from the capsule's conflict_pairs).",
          "properties": {
            "this_class": {"type": ["string", "null"]},
            "other": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "card": {"type": ["string", "null"]},
                  "class": {"type": ["string", "null"]},
                  "tier": {"type": ["string", "null"]}
                }
              }
            }
          }
        },
        "subtype_axis": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "description": "Subtype/subgroup-stratified evidence (is the call subtype-restricted, and which subtype?). Null when the subtype axis is absent (--subtypes off) so standard-run graphs stay byte-stable.",
          "properties": {
            "driving_axis": {"type": ["string", "null"], "description": "e.g. MSI, CMS, sidedness."},
            "restriction_class": {"type": ["string", "null"], "description": "e.g. pan_subtype_uniform (a decisive NEGATIVE) | subtype_stratifies_survival."},
            "omnibus": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "stat": {"type": ["string", "null"]},
                "value": {"type": ["number", "integer", "null"]}
              }
            },
            "which_separate": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "highest": {"type": ["string", "null"]},
                "lowest": {"type": ["string", "null"]}
              }
            },
            "top_subtypes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {"type": ["string", "null"]},
                  "value": {"type": ["number", "integer", "null"]},
                  "n": {"type": ["integer", "number", "null"]}
                }
              }
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "card_id"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id_ref"},
        "card_id": {"type": ["string", "null"]},
        "field": {"type": ["string", "null"]},
        "value": {},
        "dominant": {"type": "boolean"},
        "is_driving": {"type": "boolean"},
        "rationale": {"type": ["string", "null"]}
      }
    },
    "dataset": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id_ref"},
        "s3_uri": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]}
      }
    },
    "literature": {
      "type": "object",
      "additionalProperties": false,
      "description": "Empty object {} when no literature lane; otherwise the projected axes + blind spots.",
      "properties": {
        "axes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["axis_id", "question_ids", "citation_ids"],
            "additionalProperties": false,
            "properties": {
              "axis_id": {"type": ["string", "null"]},
              "question_ids": {"$ref": "#/$defs/id_ref_array"},
              "read": {"type": ["string", "null"]},
              "agreement_vs_omics": {"type": ["string", "null"]},
              "confidence": {"type": ["string", "null"]},
              "assertion": {"type": ["string", "null"]},
              "citation_ids": {"$ref": "#/$defs/id_ref_array"}
            }
          }
        },
        "blind_spots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["citation_ids"],
            "additionalProperties": false,
            "properties": {
              "text": {"type": ["string", "null"]},
              "why_omics_blind": {"type": ["string", "null"]},
              "citation_ids": {"$ref": "#/$defs/id_ref_array"}
            }
          }
        },
        "overall_consistency": {"type": ["string", "null"]},
        "key_divergence": {"type": ["string", "null"]}
      }
    },
    "citation": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id_ref"},
        "label": {"type": ["string", "null"]},
        "pmid": {"type": ["string", "null"]},
        "doi": {"type": ["string", "null"]},
        "verified": {"type": "boolean"}
      }
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "description": "Empty object {} when no llm_synthesis (or an error/skip stub); otherwise the anchored narration. Stage 2 leads with `exec_bullets` (a short crisp grounded executive summary); `rationale` is the demoted verbose full-narrative prose (renderer shows bullets first, prose behind an expander). Advisory + VERDICT-INERT: never sets the call; goldens must not depend on it (optional, provenance-wrapped trailer).",
      "properties": {
        "exec_bullets": {
          "type": "array",
          "description": "PRIMARY output (Stage 2): a short list (<=~6) of crisp bullets, each reasoning ACROSS signals and carrying the salient omics + literature data point (from key_evidence + literature axes), anchored to the package. Absent/empty when --synthesize is off.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {"type": ["string", "null"]},
              "polarity": {"type": ["string", "null"], "enum": ["supportive", "opposing", "neutral", "killer", "not_applicable", null]},
              "cites": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "question_ids": {"$ref": "#/$defs/id_ref_array"},
                  "card_ids": {"$ref": "#/$defs/id_ref_array"},
                  "citation_ids": {"$ref": "#/$defs/id_ref_array"}
                }
              }
            }
          }
        },
        "relevance": {"type": ["string", "null"]},
        "rationale": {"type": ["string", "null"], "description": "The demoted verbose 'full narrative' prose (secondary; behind an expander)."},
        "confidence_qualifier": {"type": ["string", "null"]},
        "key_caveat": {"type": ["string", "null"]},
        "cites": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "question_ids": {"$ref": "#/$defs/id_ref_array"},
            "card_ids": {"$ref": "#/$defs/id_ref_array"},
            "rule_ids": {"$ref": "#/$defs/id_ref_array"}
          }
        }
      }
    }
  }
}
