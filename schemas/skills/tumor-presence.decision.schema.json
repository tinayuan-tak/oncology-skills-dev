{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/takeda-rnd/rnd-computational-biology-oncology-target-contracts/schemas/skills/tumor-presence.decision.schema.json",
  "title": "tumor-presence decision",
  "version": "1.0.0",
  "$comment": "GENERATED by validators/gen_skill_output_schemas.py from skill_report.schema.json + skill_decision.schema.json + _skill_output/pins/tumor-presence.pins.json — DO NOT EDIT BY HAND. Self-contained (no cross-file $ref). Contract v1.0.0.",
  "$defs": {
    "skill_report": {
      "type": "object",
      "required": [
        "call",
        "role",
        "polarity",
        "honest_phrase",
        "confidence",
        "top_tension",
        "claim_chips",
        "question_table",
        "per_phase_metrics",
        "figures",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "call": {
          "description": "The verdict class (a skill-local enum, pinned per skill). null for a gateless (descriptive/inert) skill.",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "description": "How the composer treats this skill. gating = verdict can move the nomination recommendation; descriptive = real read but no gate; inert = verdict-shaped string that is explicitly not a call.",
          "type": "string",
          "enum": [
            "gating",
            "descriptive",
            "inert"
          ]
        },
        "polarity": {
          "description": "One normalized direction on the canonical order-preserving scale (_skills_common/ordinal_view.py). descriptive/inert roles are not_scored. gating roles carry a DYNAMIC polarity (killer..supportive) — do NOT pin a polarity const on a gating skill.",
          "type": "string",
          "enum": [
            "killer",
            "opposing",
            "neutral",
            "supportive",
            "insufficient",
            "not_applicable",
            "not_scored"
          ]
        },
        "honest_phrase": {
          "description": "Reader-facing one-liner derived from the signal package; its polarity must agree with `call` (INV-7).",
          "type": "string"
        },
        "confidence": {
          "description": "Weakest-link confidence.",
          "type": "object",
          "required": [
            "level"
          ],
          "additionalProperties": true,
          "properties": {
            "level": {
              "type": "string"
            },
            "basis": {
              "type": [
                "string",
                "null"
              ]
            },
            "coverage": {
              "type": [
                "object",
                "string",
                "null"
              ]
            }
          }
        },
        "top_tension": {
          "description": "The load-bearing caveat, or null.",
          "type": [
            "object",
            "null"
          ],
          "required": [
            "text"
          ],
          "additionalProperties": true,
          "properties": {
            "text": {
              "type": "string"
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            },
            "severity": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "claim_chips": {
          "description": "The A/B/C/D signal spine: per-axis {signal, corroboration, conflict} decoupled, each with role-tagged cites tracing to cards.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "label",
              "signal",
              "corroboration",
              "cites"
            ],
            "additionalProperties": true,
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "signal": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "corroboration": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "conflict": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cites": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        },
        "claim_scalars": {
          "description": "Optional per-skill scalar claim fields that are not axis chips (e.g. tumor-presence homogeneity).",
          "type": [
            "object",
            "null"
          ]
        },
        "modality_scope": {
          "description": "Per-modality (SM/degrader/ADC/TCE/antibody) signal record, or null for a modality-blind skill.",
          "type": [
            "object",
            "null"
          ]
        },
        "claim_chips_by_subtype": {
          "description": "Within-pooled subtype sub-vector for target_report.subtype_convergence, or null.",
          "type": [
            "object",
            "null"
          ]
        },
        "evidence_graph": {
          "description": "The claim-graph layer (build_evidence_graph). Attached onto the skill_report by the composer AND surfaced standalone; a named optional property so the composed skill_report validates against this strict spine (it is a render input the renderer reads off skill_report).",
          "type": [
            "object",
            "null"
          ]
        },
        "subgroup_signals": {
          "description": "Per-subgroup signal bands (abundance/generality/…). Attached onto the skill_report by the composer; a named optional property (render input read off skill_report by report_render).",
          "type": [
            "object",
            "null"
          ]
        },
        "question_table": {
          "description": "Reader Q&A rows.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "question"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string"
              },
              "question": {
                "type": "string"
              }
            }
          }
        },
        "per_phase_metrics": {
          "description": "Traceable numbers, each naming its sample_context + card_id (INV-3).",
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "figures": {
          "description": "The skill's hero + card plots, made selectable.",
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "provenance": {
          "description": "Audit: the driving rule, all fired rules, and the cards used vs missing.",
          "type": "object",
          "required": [
            "fired_rule_ids",
            "cards_used",
            "cards_missing"
          ],
          "additionalProperties": true,
          "properties": {
            "driving_rule_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "fired_rule_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cards_used": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cards_missing": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "_contract": {
          "description": "Self-documenting contract-reference string stamped by build_skill_report.",
          "type": "string"
        }
      }
    },
    "skill_decision": {
      "type": "object",
      "required": [
        "skill",
        "target",
        "indication",
        "generated_at",
        "headline",
        "cards",
        "fired_rules",
        "provenance",
        "run_health"
      ],
      "additionalProperties": true,
      "properties": {
        "skill": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "indication": {
          "description": "The indication code; null for an indication-independent skill (or a sentinel like PANCANCER if the skill emits one).",
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "headline": {
          "description": "The skill's headline block: the skill-specific verdict + facet fields (pinned per skill), the shared skill_report object, and the shared consumer-contract projections (headline_block/claim_vector/key_signals) the composer + nomination envelope read.",
          "type": "object",
          "required": [
            "skill_report"
          ],
          "additionalProperties": true,
          "properties": {
            "skill_report": {
              "oneOf": [
                {
                  "$ref": "#/$defs/skill_report"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The shared unified output object. May be null only when build_skill_report faulted (degrade-not-abort); a healthy run always emits it."
            },
            "headline_block": {
              "description": "Canonical hero payload (build_headline). Consumed by tp_evidence_package into nomination.json; typed here so a rename fails CI.",
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true,
              "properties": {
                "verdict": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "confidence": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "top_tension": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "hero": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            },
            "claim_vector": {
              "description": "The A/B/C/D signal atoms carried into nomination.json + the cross-evidence reasoner; typed here so a rename can't silently null the composition input.",
              "type": [
                "object",
                "null"
              ]
            },
            "key_signals": {
              "description": "Reader headline/supports/caveat package carried into the nomination envelope.",
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        "cards": {
          "description": "The resolved card outputs the skill consumed.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "card_id"
            ],
            "additionalProperties": true,
            "properties": {
              "card_id": {
                "type": "string"
              }
            }
          }
        },
        "fired_rules": {
          "description": "The interpretation rules that fired against the resolved cards.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule_id"
            ],
            "additionalProperties": true,
            "properties": {
              "rule_id": {
                "type": "string"
              }
            }
          }
        },
        "provenance": {
          "description": "Run-level data provenance, including per-manifest resolved release + staleness and the reproducibility lineage digests.",
          "type": "object",
          "required": [
            "data_mode",
            "resolved_releases"
          ],
          "additionalProperties": true,
          "properties": {
            "data_mode": {
              "type": "string"
            },
            "release_pin": {
              "type": [
                "string",
                "null"
              ]
            },
            "skills_repo_sha": {
              "type": [
                "string",
                "null"
              ]
            },
            "resolved_release_digest": {
              "type": [
                "string",
                "null"
              ]
            },
            "resolved_content_digest": {
              "type": [
                "string",
                "null"
              ]
            },
            "resolved_releases": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "used",
                  "is_stale"
                ],
                "additionalProperties": true,
                "properties": {
                  "used": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "head": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "is_stale": {
                    "description": "Wiring staleness audit. Required (mandatory audit field); null/stale_indeterminate is permitted for logical product-id families.",
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "run_health": {
          "description": "Per-run health telemetry.",
          "type": "object",
          "required": [
            "skill_name",
            "skill_version",
            "status"
          ],
          "additionalProperties": true,
          "properties": {
            "skill_name": {
              "type": "string"
            },
            "skill_version": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          }
        }
      }
    },
    "presence_verdict_enum": {
      "type": "string",
      "enum": [
        "broadly_high_expression",
        "strongly_upregulated_in_tumor",
        "tumor_broadly_expressed",
        "modestly_upregulated_in_tumor",
        "tumor_moderately_expressed",
        "lineage_restricted",
        "broadly_moderate_expression",
        "tumor_sparsely_expressed",
        "protein_strongly_upregulated",
        "protein_broadly_high",
        "protein_lineage_restricted",
        "protein_modestly_upregulated",
        "broadly_tumor_elevated",
        "multi_tumor_elevated",
        "protein_broadly_moderate",
        "single_tumor_elevated",
        "not_tumor_elevated",
        "sc_malignant_detected",
        "sc_microenvironment_dominant",
        "sc_broadly_low",
        "present_rna_only_protein_absent",
        "modestly_downregulated_in_tumor",
        "strongly_downregulated_in_tumor",
        "broadly_low_expression",
        "protein_modestly_downregulated",
        "protein_strongly_downregulated",
        "protein_broadly_low",
        "stromal_microenvironment_present",
        "conflicted_protein_present_rna_absent",
        "absent",
        "not_informative",
        "data_unavailable",
        "insufficient"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/skill_decision"
    },
    {
      "properties": {
        "skill": {
          "const": "tumor-presence"
        },
        "headline": {
          "type": "object",
          "required": [
            "presence_verdict",
            "presence_verdict_by_modality",
            "driving_rule_id"
          ],
          "properties": {
            "presence_verdict": {
              "$ref": "#/$defs/presence_verdict_enum"
            },
            "driving_rule_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "presence_verdict_by_modality": {
              "description": "One sub-verdict per (measurement, sample_context) bucket. Keys are `<measurement>/<sample_context>` (the 8 ALL_CONTEXTS buckets).",
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "measurement",
                  "sample_context",
                  "verdict",
                  "evidence_state"
                ],
                "additionalProperties": true,
                "properties": {
                  "measurement": {
                    "type": "string",
                    "enum": [
                      "bulk_rna",
                      "bulk_protein_ms",
                      "sc_rna",
                      "protein_ihc"
                    ]
                  },
                  "sample_context": {
                    "type": "string",
                    "enum": [
                      "cell_line",
                      "tumor",
                      "normal"
                    ]
                  },
                  "verdict": {
                    "type": "string"
                  },
                  "driving_rule_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence_state": {
                    "type": "string",
                    "enum": [
                      "measured",
                      "comparator",
                      "data_unavailable"
                    ]
                  }
                }
              }
            },
            "skill_report": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "call": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/presence_verdict_enum"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "role": {
                  "const": "descriptive"
                },
                "polarity": {
                  "const": "not_scored"
                }
              }
            }
          }
        }
      }
    }
  ]
}
