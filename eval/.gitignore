scorecard.json
known_target_panel_report.json
known-target-packages/
# A0b panel runner (#2000): generated per-target evidence-package dumps + its report — same
# treatment as known-target-packages/ above (large, live-derived, re-emittable via --emit).
scorecard_panel_report.json
scorecard-panel-packages/
# Live harvest artifacts — non-reproducible Opus lane output + derived ledgers.
# Snapshots are pinned corpora produced on demand (harvest_literature.py), not source.
literature-snapshots/
# Per-panel corpora live in their OWN dir: harvest writes <TARGET>__<INDICATION>.json, so two
# panels that share a pair (mechanism-20 and functional-requirement-20 share EGFR/LUAD, MET/LUAD,
# BRAF/SKCM, SMARCA2/LUAD, WRN/COADREAD) would OVERWRITE each other's records in one dir.
literature-snapshots-*/
# Glob, not the bare default name: --ledger-out is a CLI knob, so a panel-scoped run
# (e.g. discordance_ledger_fr20.json) is the SAME class of non-source artifact and must not
# become committable just because it was named after the panel it came from. The BASELINE
# (discordance_baseline.json) is deliberately NOT matched — that one IS source.
discordance_ledger*.json
