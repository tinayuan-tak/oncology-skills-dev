# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# Pytest
.pytest_cache/

# Environments
.venv/
.pixi/
uv.lock

# Data caches
data_cache/
data/
# catalog-query pickle cache (defaults to $TMPDIR/onc_catalog_index; a cwd override
# during a corpus regen once leaked it into the repo root — never commit it)
onc_catalog_index/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.idea/
.vscode/
*.swp
*.swo

# Generated outputs (keep in results, but ignore temp)
*.tmp

# Environment files (keep .env.example)
.env
*.env.local

# Jupyter
.ipynb_checkpoints/

# Claude Code local settings
.claude/

# Skill analysis artifacts (generated by comprehensive analysis scripts)
# Each bulk-RNA skill writes per-gene output directories under these paths.
# They contain hundreds of MB of figures and CSVs — never check in.
skills/*/crc_comprehensive_results/
skills/*/nsclc_comprehensive_results/
skills/*/*_comprehensive_results/
skills/*/test_results/

# Pre-staged reference data downloaded from S3 by analysis scripts.
# Large TSV/CSV files that should be re-fetched from S3, not committed.
skills/*/TCGA-*.tsv
skills/*/TCGA_*.csv
skills/*/*_cohort_assignments.csv
# pixi environments
.pixi/*
!.pixi/config.toml


# Cross-session coordination (see CLAUDE.md)
!.claude/config
!.claude/hooks/
.claude/branch-scope

# Retired relational skills (#1254, #654) — their names survive only as
# card-id/dispatch-key strings in combination-and-vulnerability and
# _skills_common; nothing should ever write scripts/tests under these paths
# again. Guards against a stray scaffold/mkdir re-creating the empty dirs (#2367).
skills/synthetic-lethal-partners/
skills/combinatorial-dependency/
skills/combo-and-resistance/
skills/compose-dashboard/

# Ad hoc run-output scratch dropped at the repo root by manual batch
# invocations (e.g. `batch/expression_rna_COADREAD/`) — never commit it (#2367).
/batch/
